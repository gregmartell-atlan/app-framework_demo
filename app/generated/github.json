{
  "id": "github",
  "name": "GitHub Connector",
  "logo": "https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png",
  "config": {
    "properties": {
      "credential": {
        "type": "string",
        "anyOf": { "github_token": "GitHub Personal Access Token" },
        "ui": {
          "widget": "credential",
          "label": "GitHub Credential",
          "help": "Personal Access Token with repo + read:org scopes",
          "grid": 12,
          "rules": [
            { "required": true, "message": "A GitHub credential is required" }
          ]
        }
      },
      "organization": {
        "type": "string",
        "ui": {
          "widget": "input",
          "label": "Organization",
          "help": "GitHub organization or user account to extract from",
          "placeholder": "e.g., atlanhq",
          "grid": 12,
          "rules": [
            { "required": true, "message": "Organization is required" }
          ]
        }
      },
      "repositories": {
        "type": "array",
        "ui": {
          "widget": "input",
          "label": "Repositories (optional)",
          "help": "Specific repositories to extract. Leave empty to extract all.",
          "placeholder": "e.g., atlan-python",
          "grid": 12
        }
      },
      "extract_wiki": {
        "type": "boolean",
        "default": false,
        "ui": {
          "label": "Extract Wiki Pages",
          "help": "Clone and index wiki pages from repositories",
          "grid": 12
        }
      },
      "extract_yaml": {
        "type": "boolean",
        "default": false,
        "ui": {
          "label": "Extract YAML Files",
          "help": "Extract and index YAML configuration files",
          "grid": 12
        }
      },
      "extract_sbom": {
        "type": "boolean",
        "default": false,
        "ui": {
          "label": "Extract SBOM (Software Bill of Materials)",
          "help": "Generate and extract dependency graphs using GitHub’s SBOM API",
          "grid": 12
        }
      },
      "sbom_poll_interval_seconds": {
        "type": "number",
        "default": 15,
        "ui": {
          "hidden": true
        }
      },
      "extraction_method": {
        "type": "string",
        "default": "direct",
        "ui": {
          "hidden": true
        }
      }
    },
    "steps": [
      {
        "id": "credentials",
        "label": "Credentials",
        "properties": ["credential"]
      },
      {
        "id": "scope",
        "label": "Scope",
        "properties": ["organization", "repositories"]
      },
      {
        "id": "options",
        "label": "Extraction Options",
        "properties": ["extract_wiki", "extract_yaml", "extract_sbom", "sbom_poll_interval_seconds", "extraction_method"]
      }
    ]
  }
}
