{
  "id": "atlan_api_token",
  "name": "Atlan API Token",
  "config": {
    "properties": {
      "base_url": {
        "type": "string",
        "default": "https://dsm.atlan.com",
        "ui": {
          "widget": "input",
          "label": "Atlan Base URL",
          "placeholder": "https://dsm.atlan.com",
          "grid": 12,
          "rules": [
            { "required": true, "message": "Base URL is required" }
          ]
        }
      },
      "api_key": {
        "type": "string",
        "ui": {
          "widget": "password",
          "label": "API Key",
          "help": "Atlan tenant → Settings → API Keys",
          "grid": 12,
          "rules": [
            { "required": true, "message": "API key is required" }
          ]
        }
      }
    }
  }
}
